# Copy this file to .env and fill in the token and Discord IDs locally.
# Never commit the real token.
DISCORD_TOKEN=
DISCORD_GUILD_ID=

# Join to Create -> Backstage/Hangout category -> Backstage N
BACKSTAGE_TRIGGER_CHANNEL_ID=
BACKSTAGE_CATEGORY_ID=

# Join to Perform -> Performing category -> Stage N (normal voice rooms)
STAGE_TRIGGER_CHANNEL_ID=
STAGE_CATEGORY_ID=
